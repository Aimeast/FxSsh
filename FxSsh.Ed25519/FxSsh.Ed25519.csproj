<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <!-- NativeAOT / trimming compatibility: IL2xxx warnings surface any new
         reflection/dynamic-dispatch that would break AOT publish. -->
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- Pull in the solution-wide default version -->
  <Import Project="$(MSBuildProjectDirectory)/../Version.props" />

  <PropertyGroup>
    <Authors>Aimeast</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/Aimeast/FxSsh</RepositoryUrl>
    <PackageTags>ssh,ssh-reinforcement,ssh-server,csharp,dotnet-core</PackageTags>
    <Description>FxSsh support for Ed25519 host keys.</Description>
    <!-- <SignAssembly>true</SignAssembly> -->
    <AssemblyOriginatorKeyFile>../FxSsh/FxSsh.snk</AssemblyOriginatorKeyFile>
    <Copyright>Copyright (c) Aimeast 2015-$([System.DateTime]::Now.Year)</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FxSsh.Tests" Key="" />
    <InternalsVisibleTo Include="FxSsh.Ed25519.Tests" />
  </ItemGroup>

  <PropertyGroup>
    <RootNamespace>FxSsh.Algorithms</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FxSsh\FxSsh.csproj" />
  </ItemGroup>

</Project>
